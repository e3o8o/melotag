{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/itunes/(.*)", "destination": "/api/itunes" },
    { "source": "/api/deezer/(.*)", "destination": "/api/deezer" },
    { "source": "/api/lrclib/(.*)", "destination": "/api/lrclib" },
    { "source": "/api/musicbrainz/(.*)", "destination": "/api/musicbrainz" },
    { "source": "/api/coverart/release/:release/front-500", "destination": "/api/coverart?release=:release" }
  ]
}
